  "current_product_decisions": [
    "Visible labels use EV; stable API field names may contain delta for compatibility.",
    "Reputation actions follows Partner zoos in Maps and Players.",
    "Players graph-only Elo uses post_match_elo for the selected merged identity, all statuses and both datasets, ignoring sidebar filters.",
    "Synergy values are point estimates without confidence intervals; ordinary standalone-value confidence intervals remain.",
    "Corrupted tables are excluded from every game-derived analytical view except Home.",
    "Starting position has independent First/Second player choices with at least one active; Player/Opponent Elo ranges are linked by default.",
    "Records combines MW and Base; Elo Leaderboard is loaded once and Peak Arena may legitimately be null.",
    "Arena uses full Elite League rosters and player IDs for database joins.",
    "Card + Action Card is the MW-only fifth Combos view.",
    "MW Action Cards has exactly General, Draft, By map, and Synergies."
  ],
  "global": {
    "canonical_player_elo": "pre_match_elo",
    "canonical_opponent_elo": "unique opposing player row's pre_match_elo; null for malformed/non-unique opponent rows",
    "corrupted_game_policy": "exclude table-wide from all game-derived routes except Home",
    "starting_position_values": ["First player", "Second player"],
    "default_maps": "all standard maps except Home, which defaults to all maps",
    "default_analytical_date_from": "2025-01-01",
    "default_analytical_elo_min": 300,
    "ordinary_ci": "95% interval for a standalone displayed EV using that metric's documented observation and cluster semantics",
    "synergy_ci": "unsupported",
    "unknown_request_fields": "ignored, not rejected: the backend only reads the fields a route lists in request_fields; an unlisted field has no effect on the result and must not be relied on"
  },
